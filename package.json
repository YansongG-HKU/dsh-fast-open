{
  "name": "dsh-fast-open",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "会话冷启动加速：对长会话时间线行启用 content-visibility 离屏渲染跳过，压缩首次打开时的布局/绘制时间。纯客户端、纯 CSS、可逆。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "check": "node --check index.js && node --check client.js && node --check scripts/profile-install.mjs && node --check scripts/measure-desktop.mjs && node --test \"test/unit/*.test.mjs\"",
    "install:profile": "node scripts/profile-install.mjs install",
    "uninstall:profile": "node scripts/profile-install.mjs uninstall"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "manifestVersion": 1
    }
  }
}
